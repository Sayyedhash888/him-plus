  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8C8778",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#2D6553"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string",
        "string.template"
      ],
      "settings": {
        "foreground": "#66662E"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "variable.language"
      ],
      "settings": {
        "foreground": "#7A6828"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#336A7B"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#205B44"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#27332C"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#6D675B"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.class.component",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#2D6553"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#7A6828"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#A74F47"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#336A7B",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#66662E"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#6A746C",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#336A7B",
    "type": "#336A7B",
    "class": "#336A7B",
    "enum": "#336A7B",
    "interface": "#336A7B",
    "struct": "#336A7B",
    "typeParameter": "#336A7B",
    "parameter": "#27332C",
    "variable": "#27332C",
    "property": "#27332C",
    "enumMember": "#7A6828",
    "function": "#205B44",
    "method": "#205B44",
    "macro": "#205B44",
    "keyword": "#2D6553",
    "comment": "#8C8778",
    "string": "#66662E",
    "number": "#7A6828",
    "operator": "#6D675B",
    "decorator": "#7A6828"
  }
}
